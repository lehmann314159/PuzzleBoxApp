# Copy to .env on the gx10 (never commit .env). Generate each secret with: openssl rand -hex 24
UI_TOKEN=            # the page and /api need ?t=<this> once; share it with people who should test
MCP_BEARER=          # MCP clients send "Authorization: Bearer <this>"
BOX_SECRET=          # seals MCP requestState; set it so pending confirmations survive a restart
OLLAMA_MODEL=mistral-small3.2:24b
# OLLAMA_MODELS=mistral-small3.2:24b,qwen2.5:32b-instruct-q4_K_M   # optional allow-list for the model picker
